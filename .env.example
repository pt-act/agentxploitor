# AgentxploiTor Environment Variables
# Copy to .env.local and fill in your values

# =========================================
# Redis Configuration
# =========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0

# =========================================
# PostgreSQL Configuration
# =========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentxploitor
POSTGRES_USER=agentxploitor
POSTGRES_PASSWORD=agentxploitor_dev_password
POSTGRES_MIN_CONN=5
POSTGRES_MAX_CONN=20
POSTGRES_TIMEOUT=60.0

# =========================================
# Circuit Breaker Configuration
# =========================================
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=60.0
CIRCUIT_HALF_OPEN_CALLS=3
CIRCUIT_SUCCESS_THRESHOLD=3

# =========================================
# Worker Configuration
# =========================================
WORKER_MAX_CONCURRENT=1
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=60.0

# =========================================
# Agent Configuration
# =========================================
AGENTXPLOITOR_OUTPUT_DIR=/tmp/agentxploitor
BROWSER_PERCEPTION_PATH=

# =========================================
# Analyzer Paths
# =========================================
SLITHER_PATH=slither
MYTHRIL_PATH=myth

# =========================================
# LLM Configuration (Optional)
# =========================================
OPENAI_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# =========================================
# Miniapp Configuration
# =========================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_BNKR_CONTRACT_ADDRESS=0x
NEXT_PUBLIC_TREASURY_ADDRESS=0x
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
MIN_AUDIT_PRICE_BNKR=100000000000000000000
