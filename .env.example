# AgentxploiTor Environment Variables
# Copy to .env.local and fill in your values

# =========================================
# Redis Configuration
# =========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0

# =========================================
# PostgreSQL Configuration
# =========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentxploitor
POSTGRES_USER=agentxploitor
POSTGRES_PASSWORD=agentxploitor_dev_password
POSTGRES_MIN_CONN=5
POSTGRES_MAX_CONN=20
POSTGRES_TIMEOUT=60.0

# =========================================
# Circuit Breaker Configuration
# =========================================
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=60.0
CIRCUIT_HALF_OPEN_CALLS=3
CIRCUIT_SUCCESS_THRESHOLD=3

# =========================================
# Worker Configuration
# =========================================
WORKER_MAX_CONCURRENT=1
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=60.0

# =========================================
# Agent Configuration
# =========================================
AGENTXPLOITOR_OUTPUT_DIR=/tmp/agentxploitor
BROWSER_PERCEPTION_PATH=

# =========================================
# Analyzer Paths
# =========================================
SLITHER_PATH=slither
MYTHRIL_PATH=myth

# =========================================
# LLM Configuration (Optional)
# =========================================
OPENAI_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# =========================================
# Miniapp Configuration
# =========================================
NEXT_PUBLIC_URL=https://agentxploitor.netlify.app
NEXT_PUBLIC_BNKR_CONTRACT_ADDRESS=0x
NEXT_PUBLIC_TREASURY_ADDRESS=0x
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
MIN_AUDIT_PRICE_BNKR=100000000000000000000

# =========================================
# QuickNode (Multi-Chain)
# =========================================
QUICKNODE_BASE_URL=https://your-endpoint.base-mainnet.quiknode.pro/your-api-key/
QUICKNODE_ETH_URL=https://your-endpoint.quiknode.pro/your-api-key/
QUICKNODE_BSC_URL=https://your-endpoint.bsc.quiknode.pro/your-api-key/
QUICKNODE_POLY_URL=https://your-endpoint.matic.quiknode.pro/your-api-key/
QUICKNODE_SOLANA_URL=https://your-endpoint.solana-mainnet.quiknode.pro/your-api-key/
QUICKNODE_API_KEY=your_quicknode_api_key_here

# =========================================
# E2B Sandbox Configuration
# =========================================
E2B_API_KEY=your_e2b_api_key_here
E2B_TIMEOUT=300

# =========================================
# Vercel KV / Redis Persistence
# =========================================
KV_URL=redis://localhost:6379
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_URL=
KV_REST_API_WRITE_URL=

# =========================================
# Vercel Blob (for report storage)
# =========================================
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
